# The signing secret returned by `node subscribe.mjs`, shown once at creation.
MAILTEA_WEBHOOK_SECRET=whsec_your_signing_secret

# Only needed to run subscribe.mjs.
# Create a key at https://studio.mailtea.app/api-keys
MAILTEA_API_KEY=mt_pat_your_api_key
MAILTEA_PUBLICATION_ID=pub_your_publication_id

# Where Mailtea should deliver. Must be publicly reachable over https —
# use a tunnel (ngrok, cloudflared) while developing locally.
MAILTEA_WEBHOOK_ENDPOINT=https://your-app.example.com/webhooks/mailtea

# Only for local dev or a self-hosted Mailtea. Leave unset in production.
# MAILTEA_API_BASE_URL=http://localhost:7787

# PORT=3000

# Where send-test-event.mjs posts its signed test delivery. Defaults to the
# local receiver, so you only need this when the server runs somewhere else.
# RECEIVER_URL=http://localhost:3000/webhooks/mailtea
